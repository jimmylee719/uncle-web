# ───────── 複製成 .env.local（本機）或貼到 Vercel → Settings → Environment Variables ─────────

# 正式網址（綁定自訂網域後填，用於 SEO、分享圖、sitemap）。
# 沒有自訂網域前可以不填，會自動使用 Vercel 提供的網址。
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# 加盟洽詢表單寄信（Resend：https://resend.com，有免費額度）
RESEND_API_KEY=
# 收信信箱（可多個，用逗號分隔）
FRANCHISE_INQUIRY_TO=you@example.com
# 寄件人（綁定並驗證自己的網域後才能用自訂寄件人；未填會用 Resend 測試寄件地址）
# FRANCHISE_INQUIRY_FROM=古早味網站 <noreply@your-domain.com>

# Google Search Console 驗證碼（選填）
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
